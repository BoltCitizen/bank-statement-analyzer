{
  "name": "bank-statement-analyzer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --fail-on-warnings && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vite build && npm run build:e2e && playwright test --trace off",
    "check": "svelte-check --fail-on-warnings"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
